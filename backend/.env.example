DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# Alternatively, set DB_HOST, DB_PORT, DB_NAME, DB_USER, and DB_PASSWORD.
# DATABASE_SSL=true
# DATABASE_POOL_MAX=10
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
PORT=5000
CLIENT_URL=http://localhost:3000
NODE_ENV=development
JWT_EXPIRES_IN=12h
ALLOW_SELF_REGISTRATION=false
MAX_UPLOAD_MB=5
# Microsoft Entra app registration with the Microsoft Graph Mail.Send application permission.
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# Sender mailbox user principal name or email address.
MS_SENDER=
